NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-frontend-domain.example

DB_HOST=localhost
DB_PORT=3306
DB_USER=pauline_fashion_user
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=pauline_fashion
DB_CONNECTION_LIMIT=10

# SMTP account used to deliver password reset links.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=Paulah Styles <no-reply@example.com>

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
MAX_FILE_SIZE=5242880

MPESA_ENABLED=false
# M-Pesa settings are required only when MPESA_ENABLED=true.
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=replace-me
MPESA_CONSUMER_SECRET=replace-me
MPESA_BUSINESS_SHORT_CODE=replace-me
MPESA_PASSKEY=replace-me
MPESA_CALLBACK_SECRET=replace-with-a-random-callback-secret
MPESA_CALLBACK_URL=https://your-api-domain.example/api/mpesa/callback?secret=replace-with-a-random-callback-secret

WHATSAPP_ENABLED=false
# Required only when WHATSAPP_ENABLED=true.
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_ADMIN_PHONE=254712345678
# Optional: use an approved template for messages outside the 24-hour service window.
# The template must have six body text parameters in this order: customer name,
# tracking number, order date, customer phone, delivery location, and delivery notes.
# WHATSAPP_TEMPLATE_NAME=replace-with-approved-template-name
# WHATSAPP_TEMPLATE_LANGUAGE=en_US

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
