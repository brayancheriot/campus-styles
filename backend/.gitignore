# =============================================
#  PAULINE FASHION STORE — .gitignore
# =============================================

# Environment variables — NEVER commit this
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Uploaded product images
uploads/*
!uploads/.gitkeep

# Logs
*.log
npm-debug.log*
logs/

# OS files
.DS_Store
Thumbs.db

# Editor config
.vscode/
.idea/

# Sensitive utility scripts
utils/hashAdminPassword.js